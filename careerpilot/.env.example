# ───────────────────────────────────────────────────────────────
#  CareerPilot environment — copy to .env.local and fill in.
#  All of these have FREE tiers. Do NOT enable billing anywhere.
# ───────────────────────────────────────────────────────────────

# Google AI Studio (https://aistudio.google.com/apikey) — free tier, no billing
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here

# Supabase (https://supabase.com) — free project, enable the "vector" extension
# Enable "Authentication" in the Supabase dashboard and configure
# Google OAuth + email/password auth (see SETUP.md for steps).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq (https://console.groq.com/keys) — free tier, no card. LLM FALLBACK:
# if a Gemini call hits a rate-limit/quota (429), the app automatically retries
# the same operation on Groq (llama-3.3-70b-versatile). Strongly recommended as
# demo-day insurance. Leave blank to disable the fallback (Gemini-only).
GROQ_API_KEY=your_groq_key_here

# RapidAPI → JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# Subscribe to the BASIC ($0) plan only. Leave blank to run in cache/seed-only mode.
RAPIDAPI_KEY=your_rapidapi_key_here

# Tavily (https://app.tavily.com) — free tier, no card. WEB-SEARCH FALLBACK:
# the Job Hunter agent calls Tavily for open-web job leads only when JSearch
# returns nothing. Leave blank to disable it (JSearch → seed fallback still works).
TAVILY_API_KEY=your_tavily_key_here

# O*NET Web Services (https://services.onetcenter.org/developer/) — free,
# registered access. Authoritative US-DoL occupational taxonomy used as the
# PRIMARY source for Skill Gap role benchmarks (replaces per-request LLM
# generation). Leave blank to fall back to LLM-generated benchmarks.
ONET_API_KEY=

# ── Eval suite (dev-only) ──────────────────────────────────────────────
# `npm run eval` hits the authed API routes. In dev, a request carrying this
# secret in an `x-eval-secret` header is treated as the seeded eval user.
# Pick any random string. It is INERT in production (NODE_ENV guard) and a real
# browser never sends the header, so it can't affect live sessions. Leave blank
# to skip the eval suite.
EVAL_SECRET=
# Optional: the user id the eval suite acts as. Defaults to the profile seeded by
# 0001_init.sql (00000000-0000-0000-0000-000000000001). Override only if needed.
# EVAL_USER_ID=
